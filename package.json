{
  "name": "tractorscompare",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:dataset": "npx tsx scripts/buildDataset.ts",
    "build:suitability": "npx tsx scripts/buildSuitability.ts",
    "build:best-indexes": "npx tsx scripts/buildBestIndexes.ts",
    "build:tractorfit": "npx tsx scripts/buildDataset.ts && npx tsx scripts/buildSuitability.ts",
    "prebuild": "tsx scripts/buildBestIndexes.ts",
    "build:analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "download-images": "node scripts/downloadImages.js",
    "scrape-from-brands": "node scripts/scrapeFromBrandPages.js",
    "scrape-all": "node scripts/scrapeAllTractors.js",
    "process-scraped": "node scripts/processScrapedData.js",
    "check-data": "npx tsx scripts/checkData.ts",
    "test-listings": "npx tsx scripts/testListings.ts",
    "find-images": "node scripts/findTractorImages.js",
    "update-images": "node scripts/updateTractorImages.js",
    "convert-wikimedia-urls": "node scripts/convertToFullWikimediaUrls.js",
    "find-brand-logos": "node scripts/findBrandLogos.js",
    "update-brand-logos": "node scripts/updateBrandLogos.js",
    "update-brand-websites": "node scripts/updateBrandWebsites.js",
    "fetch-news": "node scripts/fetchNews.js",
    "enrich-tractors": "node scripts/enrichTractorData.js",
    "remove-duplicate-news": "node scripts/removeDuplicateNews.js",
    "clean-old-news": "node scripts/cleanOldNews.js",
    "update-news": "node scripts/updateNews.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "normalize-tractors": "npx tsx scripts/normalizeProcessedTractors.ts",
    "prune-old-tractors": "npx tsx scripts/pruneOldTractors.ts"
  },
  "dependencies": {
    "@types/nodemailer": "^7.0.4",
    "@vercel/analytics": "^1.6.1",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "fs-extra": "^11.3.2",
    "lucide-react": "^0.468.0",
    "next": "15.5.10",
    "nodemailer": "^7.0.12",
    "puppeteer": "^24.33.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.17",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.5.10",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9"
  }
}
